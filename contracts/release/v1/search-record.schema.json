{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artemsemdev.github.io/SeaRise-Europe/contracts/release/v1/search-record.schema.json",
  "title": "SeaRise Europe normalized settlement search record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "dataReleaseId",
    "dataProvenanceClass",
    "id",
    "canonicalName",
    "asciiName",
    "alternateNames",
    "countryCode",
    "admin1Code",
    "admin1Name",
    "location",
    "population",
    "featureCode",
    "distanceToCoastMeters",
    "isCoastal",
    "catalogMembership",
    "sourceUpdatedAt"
  ],
  "properties": {
    "$schema": {
      "const": "https://artemsemdev.github.io/SeaRise-Europe/contracts/release/v1/search-record.schema.json"
    },
    "schemaVersion": { "$ref": "defs.schema.json#/$defs/schemaVersion" },
    "dataReleaseId": { "$ref": "defs.schema.json#/$defs/dataReleaseId" },
    "dataProvenanceClass": { "$ref": "defs.schema.json#/$defs/dataProvenanceClass" },
    "id": { "type": "integer", "minimum": 1 },
    "canonicalName": { "type": "string", "minLength": 1 },
    "asciiName": { "type": "string", "minLength": 1 },
    "alternateNames": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "countryCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "admin1Code": { "type": ["string", "null"], "minLength": 1 },
    "admin1Name": { "type": ["string", "null"], "minLength": 1 },
    "location": { "$ref": "defs.schema.json#/$defs/coordinates" },
    "population": { "type": ["integer", "null"], "minimum": 0 },
    "featureCode": {
      "enum": [
        "PPL",
        "PPLA",
        "PPLA2",
        "PPLA3",
        "PPLA4",
        "PPLA5",
        "PPLC",
        "PPLF",
        "PPLG",
        "PPLL",
        "PPLR"
      ]
    },
    "distanceToCoastMeters": { "type": "number", "minimum": 0 },
    "isCoastal": { "type": "boolean" },
    "catalogMembership": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["europe-core", "europe-coastal"] }
    },
    "sourceUpdatedAt": { "type": ["string", "null"], "format": "date" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "isCoastal": { "const": true } },
        "required": ["isCoastal"]
      },
      "then": {
        "properties": {
          "catalogMembership": { "contains": { "const": "europe-coastal" } }
        }
      }
    },
    {
      "if": {
        "properties": { "isCoastal": { "const": false } },
        "required": ["isCoastal"]
      },
      "then": {
        "properties": {
          "catalogMembership": {
            "not": { "contains": { "const": "europe-coastal" } }
          }
        }
      }
    }
  ]
}
