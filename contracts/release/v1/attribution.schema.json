{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artemsemdev.github.io/SeaRise-Europe/contracts/release/v1/attribution.schema.json",
  "title": "SeaRise Europe source attribution registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "dataReleaseId",
    "dataProvenanceClass",
    "records"
  ],
  "properties": {
    "$schema": {
      "const": "https://artemsemdev.github.io/SeaRise-Europe/contracts/release/v1/attribution.schema.json"
    },
    "schemaVersion": { "$ref": "defs.schema.json#/$defs/schemaVersion" },
    "dataReleaseId": { "$ref": "defs.schema.json#/$defs/dataReleaseId" },
    "dataProvenanceClass": { "$ref": "defs.schema.json#/$defs/dataProvenanceClass" },
    "records": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attributionId",
        "sourceId",
        "title",
        "sourceUrl",
        "licence",
        "attributionText",
        "redistribution",
        "sourceSha256",
        "appliesToRoles"
      ],
      "properties": {
        "attributionId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]+$"
        },
        "sourceId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9./_-]+$"
        },
        "title": { "type": "string", "minLength": 1 },
        "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "licence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spdxId", "name", "url"],
          "properties": {
            "spdxId": { "type": "string", "pattern": "^[A-Za-z0-9.+-]+$" },
            "name": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "format": "uri", "pattern": "^https://" }
          }
        },
        "attributionText": { "type": "string", "minLength": 1 },
        "redistribution": { "enum": ["allowed", "conditional", "prohibited"] },
        "derivativeNotice": { "type": "string", "minLength": 1 },
        "sourceSha256": { "$ref": "defs.schema.json#/$defs/sha256" },
        "appliesToRoles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "defs.schema.json#/$defs/artifactRole" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "redistribution": { "const": "conditional" } },
            "required": ["redistribution"]
          },
          "then": { "required": ["derivativeNotice"] }
        }
      ]
    }
  }
}
