{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artemsemdev.github.io/SeaRise-Europe/contracts/release/v1/defs.schema.json",
  "title": "SeaRise Europe release contract definitions v1",
  "$defs": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "dataReleaseId": {
      "type": "string",
      "pattern": "^searise-europe-v[0-9]+\\.[0-9]+\\.[0-9]+-[0-9]{8}-[a-f0-9]{12}$"
    },
    "scenarioId": {
      "enum": ["ssp1-26", "ssp2-45", "ssp5-85"]
    },
    "horizonYear": {
      "enum": [2030, 2050, 2100]
    },
    "resultState": {
      "enum": [
        "ProjectionAvailable",
        "DataUnavailable",
        "OutOfScope",
        "UnsupportedGeography"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "releaseRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[?#\\\\])(?:[A-Za-z0-9][A-Za-z0-9._-]*)(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
    },
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "releaseAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "automatedValidation",
        "releaseDisposition",
        "dataProvenanceClass",
        "statusDisclosureRequired"
      ],
      "properties": {
        "automatedValidation": {
          "enum": ["pending", "passed", "failed"]
        },
        "releaseDisposition": {
          "enum": ["pending-owner", "approved", "rejected", "blocked"]
        },
        "dataProvenanceClass": {
          "enum": ["real-source", "synthetic-fixture"]
        },
        "statusDisclosureRequired": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "releaseDisposition": { "const": "approved" }
            },
            "required": ["releaseDisposition"]
          },
          "then": {
            "properties": {
              "automatedValidation": { "const": "passed" },
              "dataProvenanceClass": { "const": "real-source" }
            }
          }
        },
        {
          "if": {
            "not": {
              "properties": {
                "releaseDisposition": { "const": "approved" }
              },
              "required": ["releaseDisposition"]
            }
          },
          "then": {
            "properties": {
              "statusDisclosureRequired": { "const": true }
            }
          }
        },
        {
          "if": {
            "properties": {
              "dataProvenanceClass": { "const": "synthetic-fixture" }
            },
            "required": ["dataProvenanceClass"]
          },
          "then": {
            "properties": {
              "releaseDisposition": {
                "enum": ["pending-owner", "rejected", "blocked"]
              },
              "statusDisclosureRequired": { "const": true }
            }
          }
        }
      ]
    }
  }
}
