{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artemsemdev.github.io/SeaRise-Europe/contracts/release/v2/browser-derivation-provenance.schema.json",
  "title": "SeaRise Europe browser derivation provenance v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "_type", "subject", "predicateType", "predicate"],
  "properties": {
    "$schema": { "const": "https://artemsemdev.github.io/SeaRise-Europe/contracts/release/v2/browser-derivation-provenance.schema.json" },
    "schemaVersion": { "const": "2.0.0" },
    "_type": { "const": "https://in-toto.io/Statement/v1" },
    "subject": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "digest"],
        "properties": {
          "name": { "$ref": "defs.schema.json#/$defs/releaseRelativePath" },
          "digest": {
            "type": "object", "additionalProperties": false, "required": ["sha256"],
            "properties": { "sha256": { "$ref": "defs.schema.json#/$defs/sha256" } }
          }
        }
      }
    },
    "predicateType": { "const": "https://artemsemdev.github.io/SeaRise-Europe/contracts/release/v2/browser-derivation-predicate/v1" },
    "predicate": {
      "type": "object", "additionalProperties": false,
      "required": ["derivationType", "executionIdentity", "materials", "receipt", "nonClaims"],
      "properties": {
        "derivationType": { "const": "deterministic-browser-overlay" },
        "executionIdentity": { "const": "not-recorded" },
        "materials": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "defs.schema.json#/$defs/fileIdentity" } },
        "receipt": { "$ref": "defs.schema.json#/$defs/fileIdentity" },
        "nonClaims": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
