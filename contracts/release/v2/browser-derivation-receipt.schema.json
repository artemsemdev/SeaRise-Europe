{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artemsemdev.github.io/SeaRise-Europe/contracts/release/v2/browser-derivation-receipt.schema.json",
  "title": "SeaRise Europe deterministic browser derivation receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "receiptType", "dataReleaseId", "dataProvenanceClass", "executionIdentity", "materials", "outputs", "nonClaims"],
  "properties": {
    "$schema": { "const": "https://artemsemdev.github.io/SeaRise-Europe/contracts/release/v2/browser-derivation-receipt.schema.json" },
    "schemaVersion": { "const": "2.0.0" },
    "receiptType": { "const": "browser-overlay-derivation" },
    "dataReleaseId": { "$ref": "defs.schema.json#/$defs/dataReleaseId" },
    "dataProvenanceClass": { "$ref": "defs.schema.json#/$defs/dataProvenanceClass" },
    "executionIdentity": { "const": "not-recorded" },
    "materials": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "defs.schema.json#/$defs/fileIdentity" }
    },
    "outputs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "defs.schema.json#/$defs/fileIdentity" }
    },
    "nonClaims": {
      "type": "array",
      "prefixItems": [
        { "const": "No build run, workflow, platform, timestamp, or code revision is asserted for this deterministic browser derivation." },
        {
          "enum": [
            "This receipt is not the authoritative build receipt for the sealed v1 release.",
            "This receipt is not the authoritative build receipt for the private Phase 1 candidate."
          ]
        },
        {
          "enum": [
            "This synthetic fixture is not approved real-source public-release evidence.",
            "This private real-source binding is not approved public-release evidence."
          ]
        }
      ],
      "items": false, "minItems": 3, "maxItems": 3
    }
  }
}
