{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artemsemdev.github.io/SeaRise-Europe/contracts/repository-removal/v1/evidence-receipt.schema.json",
  "title": "SeaRise Europe repository-removal evidence receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receiptId",
    "auditedCommit",
    "inventorySha256",
    "recordedAt",
    "cleanClone",
    "browserDisposition",
    "candidateIsolation",
    "externalResourceMutation",
    "checks"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "receiptId": { "type": "string", "pattern": "^repository-removal-evidence-v1-[a-z0-9-]+$" },
    "auditedCommit": { "$ref": "#/$defs/gitCommit" },
    "inventorySha256": { "$ref": "#/$defs/sha256" },
    "recordedAt": { "type": "string", "format": "date-time" },
    "cleanClone": { "const": true },
    "browserDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "firefox", "webkit", "threeBrowserSupportClaim"],
      "properties": {
        "required": { "const": "chromium" },
        "firefox": { "const": "deferred" },
        "webkit": { "const": "optional-historical-evidence" },
        "threeBrowserSupportClaim": { "const": false }
      }
    },
    "candidateIsolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateV7BytesUsed", "tarBytesUsed", "uploaded"],
      "properties": {
        "candidateV7BytesUsed": { "const": false },
        "tarBytesUsed": { "const": false },
        "uploaded": { "const": false }
      }
    },
    "externalResourceMutation": { "const": false },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check" }
    }
  },
  "$defs": {
    "gitCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "result", "outputSha256", "evidencePaths"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "command": { "type": "string", "minLength": 1 },
        "result": { "const": "passed" },
        "outputSha256": { "$ref": "#/$defs/sha256" },
        "evidencePaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
