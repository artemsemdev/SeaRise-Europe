{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artemsemdev.github.io/SeaRise-Europe/contracts/supply-chain/v1/dependency-exception.schema.json",
  "title": "SeaRise Europe dependency finding exception v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "contractId",
    "exceptionId",
    "findingId",
    "ecosystem",
    "component",
    "owner",
    "scope",
    "rationale",
    "approvedAt",
    "expiresAt",
    "fixtureOnly"
  ],
  "properties": {
    "$schema": {
      "const": "https://artemsemdev.github.io/SeaRise-Europe/contracts/supply-chain/v1/dependency-exception.schema.json"
    },
    "schemaVersion": { "const": "1.0.0" },
    "contractId": { "const": "phase-1-dependency-exception-v1" },
    "exceptionId": { "type": "string", "pattern": "^dep-exception-[a-z0-9-]+$" },
    "findingId": { "type": "string", "minLength": 1 },
    "ecosystem": {
      "enum": ["container", "dotnet", "github-actions", "npm", "pip"]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "purl"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "purl": { "type": "string", "pattern": "^pkg:" }
      }
    },
    "owner": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "rationale": { "type": "string", "minLength": 20 },
    "approvedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "fixtureOnly": { "type": "boolean" }
  }
}
