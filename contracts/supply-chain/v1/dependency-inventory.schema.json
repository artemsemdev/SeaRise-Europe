{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artemsemdev.github.io/SeaRise-Europe/contracts/supply-chain/v1/dependency-inventory.schema.json",
  "title": "SeaRise dependency-defining input inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "inventoryKind", "productionClaim", "components"],
  "properties": {
    "$schema": { "const": "./dependency-inventory.schema.json" },
    "schemaVersion": { "const": "1.0.0" },
    "inventoryKind": { "const": "dependency-defining-inputs" },
    "productionClaim": { "const": false },
    "components": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ecosystem", "releaseUse", "coverage", "inputs", "note"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "ecosystem": {
            "enum": [
              "container",
              "github-actions",
              "native",
              "npm",
              "nuget",
              "opentofu",
              "python",
              "standard-schema"
            ]
          },
          "releaseUse": { "enum": ["candidate", "development", "legacy", "not-present"] },
          "coverage": { "enum": ["locked", "range-constrained", "not-present"] },
          "inputs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "role", "sha256"],
              "properties": {
                "path": { "type": "string", "pattern": "^[^/].*" },
                "role": { "enum": ["lock", "manifest", "receipt", "recipe", "schema", "workflow"] },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            }
          },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
