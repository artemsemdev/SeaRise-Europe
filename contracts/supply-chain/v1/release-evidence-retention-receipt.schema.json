{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artemsemdev.github.io/SeaRise-Europe/contracts/supply-chain/v1/release-evidence-retention-receipt.schema.json",
  "title": "SeaRise Europe exact local release evidence handoff receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "receiptType", "candidateId", "dataReleaseId", "dataProvenanceClass", "controlledBuildRunId", "files", "handoff", "claims", "deterministicIdentity"],
  "properties": {
    "$schema": { "const": "https://artemsemdev.github.io/SeaRise-Europe/contracts/supply-chain/v1/release-evidence-retention-receipt.schema.json" },
    "schemaVersion": { "const": "1.0.0" },
    "receiptType": { "const": "phase-1-release-evidence-local-handoff-v1" },
    "candidateId": { "type": "string", "pattern": "^candidate-[a-z0-9][a-z0-9-]+$" },
    "dataReleaseId": { "type": "string", "pattern": "^searise-europe-v[0-9]+\\.[0-9]+\\.[0-9]+-[0-9]{8}-[a-f0-9]{12}$" },
    "dataProvenanceClass": { "enum": ["synthetic-fixture", "real-source"] },
    "controlledBuildRunId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "files": {
      "type": "array",
      "prefixItems": [
        { "allOf": [{ "$ref": "#/$defs/file" }, { "properties": { "path": { "const": "evidence-envelope.json" } } }] },
        { "allOf": [{ "$ref": "#/$defs/file" }, { "properties": { "path": { "const": "manifest.json" } } }] },
        { "allOf": [{ "$ref": "#/$defs/file" }, { "properties": { "path": { "const": "manifest.sigstore.json" } } }] },
        { "allOf": [{ "$ref": "#/$defs/file" }, { "properties": { "path": { "const": "provenance.intoto.jsonl" } } }] },
        { "allOf": [{ "$ref": "#/$defs/file" }, { "properties": { "path": { "const": "provenance.sigstore.json" } } }] },
        { "allOf": [{ "$ref": "#/$defs/file" }, { "properties": { "path": { "const": "receipts/cryptographic-verification.json" } } }] },
        { "allOf": [{ "$ref": "#/$defs/file" }, { "properties": { "path": { "const": "receipts/public-readback.json" } } }] },
        { "allOf": [{ "$ref": "#/$defs/file" }, { "properties": { "path": { "const": "sbom/build-plane.cdx.json" } } }] },
        { "allOf": [{ "$ref": "#/$defs/file" }, { "properties": { "path": { "const": "sbom/frontend-npm.cdx.json" } } }] },
        { "allOf": [{ "$ref": "#/$defs/file" }, { "properties": { "path": { "const": "sbom/nuget/searise-api-net8.0.cdx.json" } } }] },
        { "allOf": [{ "$ref": "#/$defs/file" }, { "properties": { "path": { "const": "sbom/nuget/searise-application-net8.0.cdx.json" } } }] },
        { "allOf": [{ "$ref": "#/$defs/file" }, { "properties": { "path": { "const": "sbom/nuget/searise-domain-net8.0.cdx.json" } } }] },
        { "allOf": [{ "$ref": "#/$defs/file" }, { "properties": { "path": { "const": "sbom/nuget/searise-infrastructure-net8.0.cdx.json" } } }] },
        { "allOf": [{ "$ref": "#/$defs/file" }, { "properties": { "path": { "const": "sbom/python-release-linux-x86-64-cp311.cdx.json" } } }] },
        { "allOf": [{ "$ref": "#/$defs/file" }, { "properties": { "path": { "const": "sbom/python-release-macos-arm64-cp311.cdx.json" } } }] },
        { "allOf": [{ "$ref": "#/$defs/file" }, { "properties": { "path": { "const": "sbom/python-settlement-spatial-linux-x86-64-cp311.cdx.json" } } }] },
        { "allOf": [{ "$ref": "#/$defs/file" }, { "properties": { "path": { "const": "sbom/python-settlement-spatial-macos-arm64-cp311.cdx.json" } } }] }
      ],
      "items": false,
      "minItems": 17,
      "maxItems": 17,
      "uniqueItems": true
    },
    "handoff": {
      "const": {
        "class": "local-atomic-no-overwrite",
        "initialPublicationOverwriteAllowed": false,
        "externalRetentionPolicy": "required-not-verified",
        "deletionPrevention": "not-verified",
        "coRetentionWithDataRelease": "not-verified"
      }
    },
    "claims": {
      "const": {
        "exactLocalEvidenceSet": true,
        "cryptographicVerificationReceiptRetained": true,
        "publicReadbackReceiptRetained": true,
        "receiptAuthorityReverified": false,
        "productionClaim": false,
        "publicationApproval": false,
        "scientificApproval": false
      }
    },
    "deterministicIdentity": {
      "description": "SHA-256 of canonical receipt bytes with this member omitted; consumers must recompute it.",
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "byteSize", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[?#\\\\])(?:[A-Za-z0-9][A-Za-z0-9._-]*)(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$" },
        "byteSize": { "type": "integer", "minimum": 1, "maximum": 134217728 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
