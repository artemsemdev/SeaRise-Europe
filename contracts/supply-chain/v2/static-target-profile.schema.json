{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artemsemdev.github.io/SeaRise-Europe/contracts/supply-chain/v2/static-target-profile.schema.json",
  "title": "SeaRise static-target supply-chain transition profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "profileId",
    "target",
    "productionClaim",
    "activation",
    "historicalEvidence",
    "excludedLegacyRequirements",
    "components"
  ],
  "properties": {
    "$schema": { "const": "./static-target-profile.schema.json" },
    "schemaVersion": { "const": "2.0.0" },
    "profileId": { "const": "static-browser-supply-chain-v2" },
    "target": { "const": "static-browser" },
    "productionClaim": { "const": false },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "blockingIssues", "pendingSelectors"],
      "properties": {
        "status": { "enum": ["pending-legacy-removal", "active"] },
        "blockingIssues": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        },
        "pendingSelectors": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "issue", "path", "selector"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "issue": { "type": "integer", "minimum": 1 },
              "path": { "type": "string", "minLength": 1 },
              "selector": { "type": "string", "minLength": 1 }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "active" } } },
          "then": {
            "properties": {
              "blockingIssues": { "maxItems": 0 },
              "pendingSelectors": { "maxItems": 0 }
            }
          },
          "else": {
            "properties": {
              "blockingIssues": { "minItems": 1 },
              "pendingSelectors": { "minItems": 1 }
            }
          }
        }
      ]
    },
    "historicalEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "status",
        "dependencyInventory",
        "gitAuthority",
        "modeAuthority",
        "validatorAuthority"
      ],
      "properties": {
        "path": { "const": "contracts/supply-chain/v1" },
        "status": { "const": "immutable-phase-1-history" },
        "dependencyInventory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": { "const": "contracts/supply-chain/v1/dependency-inventory.json" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "gitAuthority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commit", "tree", "phase1ContractsTree"],
          "properties": {
            "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "phase1ContractsTree": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          }
        },
        "modeAuthority": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "enum": ["100644", "100755"]
          },
          "propertyNames": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
          }
        },
        "validatorAuthority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "gitBlob"],
          "properties": {
            "path": {
              "const": "contracts/supply-chain/v2/historical/v1-contracts.py"
            },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "gitBlob": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          }
        }
      }
    },
    "excludedLegacyRequirements": {
      "const": [
        "api-nuget",
        "azurite-blob-seed",
        "legacy-compose-runtime",
        "legacy-runtime-images",
        "nextjs-frontend-runtime"
      ]
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ecosystem", "releaseUse", "coverage", "inputs"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "ecosystem": {
            "enum": [
              "container",
              "cyclonedx",
              "github-actions",
              "native",
              "npm",
              "python",
              "standard-schema"
            ]
          },
          "releaseUse": { "enum": ["candidate", "development"] },
          "coverage": { "enum": ["locked", "range-constrained"] },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "role", "sha256"],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
                },
                "role": {
                  "enum": [
                    "lock",
                    "manifest",
                    "receipt",
                    "recipe",
                    "sbom",
                    "schema",
                    "workflow"
                  ]
                },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            }
          }
        }
      }
    }
  }
}
