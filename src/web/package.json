{
  "name": "@searise/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20.20.1",
    "npm": "11.12.1"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint . && node scripts/check-boundaries.mjs",
