{
  "name": "@searise/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20.20.1",
    "npm": "11.12.1"
  },
  "scripts": {
    "generate:contracts": "node scripts/generate-release-contracts.mjs",
    "generate:scientific-fixture": "PYTHONPATH=../pipeline python3 ../../scripts/release/build-browser-integrity-fixture.py && node scripts/generate-scientific-fixture-contracts.mjs",
    "check:scientific-fixture": "node scripts/generate-scientific-fixture-contracts.mjs --check",
    "check:contracts": "node scripts/generate-release-contracts.mjs --check",
    "generate:search-fixture": "node scripts/generate-search-fixture.mjs",
    "check:search-fixture": "node scripts/generate-search-fixture.mjs --check",
    "test:search-shard-builder": "vitest run scripts/search-shard-builder.test.mjs",
    "build:search-shards": "node scripts/build-settlement-search-shards.mjs build",
    "validate:search-shards": "node scripts/build-settlement-search-shards.mjs validate",
    "measure:local-candidate-search": "node scripts/measure-local-candidate-search.mjs",
    "measure:ar6-release": "node scripts/measure-ar6-release.mjs",
    "dev": "vite",
    "serve:local-release": "node scripts/serve-local-release.mjs",
    "serve:committed-release": "node scripts/serve-committed-release.mjs",
    "e2e:local-candidate": "node scripts/run-local-candidate-e2e.mjs",
    "evidence:pmtiles-render": "node scripts/render-pmtiles-evidence.mjs --check",
    "lint": "eslint . && node scripts/check-boundaries.mjs && node scripts/check-target-content.mjs && npm run check:contracts && npm run check:search-fixture && npm run check:scientific-fixture",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build && node scripts/check-target-content.mjs --built dist && node scripts/inspect-build.mjs",
    "serve": "vite preview --host 127.0.0.1 --port 4173",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "brotli-wasm": "3.0.1",
    "geotiff": "3.0.5",
    "hyparquet": "1.28.2",
    "hyparquet-compressors": "1.1.1",
    "maplibre-gl": "^5.19.0",
    "pmtiles": "^4.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "2.0.5",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "fflate": "0.8.3",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "fast-check": "4.9.0",
    "jsdom": "29.1.1",
    "pbf": "4.0.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
