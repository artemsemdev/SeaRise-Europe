{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artemsemdev.github.io/SeaRise-Europe/pipeline/offline-release/stage-receipt-v1.schema.json",
  "title": "SeaRise Europe offline release internal stage receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "stage",
    "stageKeySha256",
    "status",
    "outputs",
    "warnings",
    "qualityResults"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "stage": {
      "enum": [
        "verify-sources",
        "inspect",
        "normalize",
        "derive",
        "package",
        "validate",
        "assemble-release"
      ]
    },
    "stageKeySha256": { "$ref": "#/$defs/sha256" },
    "status": { "const": "complete" },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/output" }
    },
    "warnings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[^\\r\\n]+$"
      }
    },
    "qualityResults": { "type": "object" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "byteSize", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[\\\\\\r\\n]).+$"
        },
        "byteSize": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
