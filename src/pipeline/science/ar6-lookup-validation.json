      "outsideCoastalScope": "outside-coastal-scope",
      "outsideEuropeSupport": "outside-europe-support"
    },
    "sourceIdentityFields": [
      "locationId",
      "latitude",
      "longitude",
      "family",
      "distanceKm"
    ]
  },
  "validation": {
