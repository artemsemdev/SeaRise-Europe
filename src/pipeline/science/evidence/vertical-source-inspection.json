  "baselineSelection": {
    "id": "monthly-sla-plus-static-mdt-v202411",
    "result": "selected",
    "reason": "The official monthly dataset contains SLA only. Its Product User Manual defines each monthly value as the simple temporal average of available daily L4 products. Since MDT is static and daily ADT equals SLA plus MDT, the 7305-calendar-day weighted mean of the complete 240-month SLA set plus the exact MDT grid is algebraically the selected daily-ADT mean.",
    "equation": "mean_1995_2014(ADT_GOCO06S) = sum(monthly_SLA * calendar_days) / 7305 + MDT_GOCO06S",
    "failClosedConditions": [
      "any month from 1995-01 through 2014-12 is absent or duplicated",
      "the month timestamp or calendar-day weight is inconsistent",
