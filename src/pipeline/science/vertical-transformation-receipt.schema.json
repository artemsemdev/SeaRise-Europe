{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://searise.example/schemas/vertical-transformation-receipt.schema.json",
  "title": "Vertical transformation evidence receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schemaVersion", "receiptId", "issue", "recordedAt", "status",
    "methodologyId", "inputContracts", "sourceInputs", "software", "baseline",
    "grid", "geoid", "transform", "uncertainty", "outputs", "validation", "blockers"
  ],
  "properties": {
    "$schema": { "const": "../vertical-transformation-receipt.schema.json" },
    "schemaVersion": { "const": 1 },
    "receiptId": { "type": "string", "minLength": 1 },
    "issue": { "const": 83 },
    "recordedAt": { "type": "string", "format": "date" },
    "status": { "enum": ["publishable", "implementation-complete-publication-blocked", "failed"] },
    "methodologyId": { "const": "absolute-mean-water-surface-egm2008-interval-v1" },
    "inputContracts": {
      "type": "array", "minItems": 3, "uniqueItems": true,
      "items": { "$ref": "#/$defs/hashedPath" }
    },
    "sourceInputs": {
      "type": "array", "minItems": 5, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["sourceId", "version", "assetId", "sha256", "members", "verification"],
        "properties": {
          "sourceId": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "assetId": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "members": {
            "type": "array", "uniqueItems": true,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "sha256"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "sha256": { "$ref": "#/$defs/sha256" }
              }
            }
          },
          "verification": { "const": "locked-and-verified" }
        }
      }
    },
    "software": {
      "type": "object", "additionalProperties": false,
      "required": ["runtime", "packages", "externalGeoidEngine"],
      "properties": {
        "runtime": { "type": "string", "minLength": 1 },
        "packages": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 }
            }
          }
        },
        "externalGeoidEngine": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "name", "version"],
          "properties": {
            "status": { "enum": ["locked", "pending"] },
            "name": { "type": ["string", "null"], "minLength": 1 },
            "version": { "type": ["string", "null"], "minLength": 1 }
          }
        }
      }
    },
    "baseline": {
      "type": "object", "additionalProperties": false,
      "required": ["referencePeriod", "monthlyObjectCount", "calendarDayWeight", "aggregation", "missingPeriodRule"],
      "properties": {
        "referencePeriod": {
          "type": "object", "additionalProperties": false,
          "required": ["startInclusive", "endExclusive"],
          "properties": {
            "startInclusive": { "const": "1995-01-01" },
            "endExclusive": { "const": "2015-01-01" }
          }
        },
        "monthlyObjectCount": { "const": 240 },
        "calendarDayWeight": { "const": 7305 },
        "aggregation": { "const": "calendar-day-weighted-complete-months-plus-static-mdt" },
        "missingPeriodRule": { "const": "nodata" }
      }
    },
    "grid": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "horizontalCrs", "verticalCrs", "shape", "affine", "pixelInterpretation", "continuousInterpolation", "categoricalInterpolation", "extrapolation", "nodataRule"],
      "properties": {
        "status": { "enum": ["locked", "pending-phase-0.8"] },
        "horizontalCrs": { "type": ["string", "null"], "minLength": 1 },
        "verticalCrs": { "const": "EPSG:3855" },
        "shape": {
          "oneOf": [
            { "type": "null" },
            { "type": "array", "prefixItems": [{ "type": "integer", "minimum": 1 }, { "type": "integer", "minimum": 1 }], "items": false }
          ]
        },
        "affine": {
          "oneOf": [
            { "type": "null" },
            { "type": "array", "minItems": 6, "maxItems": 6, "items": { "type": "number" } }
          ]
        },
        "pixelInterpretation": { "enum": ["RasterPixelIsPoint", null] },
        "continuousInterpolation": { "const": "bilinear-inside-source-support" },
        "categoricalInterpolation": { "const": "nearest-neighbour" },
        "extrapolation": { "const": "none" },
        "nodataRule": { "const": "propagate-any-missing-source-or-neighbour" }
      }
    },
    "geoid": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "commonEllipsoid", "permanentTideRule", "source", "target"],
      "properties": {
        "status": { "enum": ["ready", "blocked"] },
        "commonEllipsoid": { "type": ["string", "null"], "minLength": 1 },
        "permanentTideRule": { "type": ["string", "null"], "minLength": 1 },
        "source": { "$ref": "#/$defs/geoidModel" },
        "target": { "$ref": "#/$defs/geoidModel" }
      }
    },
    "transform": {
      "type": "object", "additionalProperties": false,
      "required": ["baselineEquation", "geoidEquation", "waterEquations", "clearanceEquations", "projectionQuantiles", "nodataClass", "reasonCodeContract"],
      "properties": {
        "baselineEquation": { "type": "string", "minLength": 1 },
        "geoidEquation": { "type": "string", "minLength": 1 },
        "waterEquations": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string", "minLength": 1 } },
        "clearanceEquations": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string", "minLength": 1 } },
        "projectionQuantiles": { "type": "array", "prefixItems": [{ "const": 0.167 }, { "const": 0.5 }, { "const": 0.833 }], "items": false },
        "nodataClass": { "const": 255 },
        "reasonCodeContract": { "type": "string", "minLength": 1 }
      }
    },
    "uncertainty": {
      "type": "object", "additionalProperties": false,
      "required": ["aggregation", "baselineTerms", "terrainTerms", "numericBoundsStatus", "maximumTotalUncertaintyMetres"],
      "properties": {
        "aggregation": { "const": "sum-absolute-bounds" },
        "baselineTerms": { "$ref": "#/$defs/terms" },
        "terrainTerms": { "$ref": "#/$defs/terms" },
        "numericBoundsStatus": { "enum": ["complete", "blocked"] },
        "maximumTotalUncertaintyMetres": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "outputs": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "artifacts"],
      "properties": {
        "status": { "enum": ["generated", "not-generated"] },
        "artifacts": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/hashedPath" } }
      },
      "allOf": [{
        "if": { "properties": { "status": { "const": "generated" } } },
        "then": { "properties": { "artifacts": { "minItems": 1 } } },
        "else": { "properties": { "artifacts": { "maxItems": 0 } } }
      }]
    },
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": ["automatedTests", "independentReview", "crossEnvironment", "basinControls"],
      "properties": {
        "automatedTests": { "$ref": "#/$defs/checkStatus" },
        "independentReview": { "$ref": "#/$defs/checkStatus" },
        "crossEnvironment": { "$ref": "#/$defs/checkStatus" },
        "basinControls": { "$ref": "#/$defs/checkStatus" }
      }
    },
    "blockers": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "owner", "requiredEvidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "requiredEvidence": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "allOf": [{
    "if": { "properties": { "status": { "const": "publishable" } } },
    "then": {
      "properties": {
        "blockers": { "maxItems": 0 },
        "outputs": { "properties": { "status": { "const": "generated" } } },
        "grid": { "properties": { "status": { "const": "locked" } } },
        "geoid": { "properties": { "status": { "const": "ready" } } },
        "uncertainty": { "properties": { "numericBoundsStatus": { "const": "complete" }, "maximumTotalUncertaintyMetres": { "type": "number" } } },
        "validation": { "properties": { "automatedTests": { "const": "passed" }, "independentReview": { "const": "passed" }, "crossEnvironment": { "const": "passed" }, "basinControls": { "const": "passed" } } }
      }
    }
  }],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "hashedPath": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "geoidModel": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "version", "memberSha256", "nativeTideSystem", "outputTideSystem", "evaluationEpoch", "maximumDegree", "maximumOrder", "normalization", "earthGravityConstant", "referenceRadiusMetres"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "memberSha256": { "$ref": "#/$defs/sha256" },
        "nativeTideSystem": { "type": "string", "minLength": 1 },
        "outputTideSystem": { "const": "tide_free" },
        "evaluationEpoch": { "type": ["string", "null"], "format": "date" },
        "maximumDegree": { "type": "integer", "minimum": 1 },
        "maximumOrder": { "type": "integer", "minimum": 0 },
        "normalization": { "type": "string", "minLength": 1 },
        "earthGravityConstant": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "referenceRadiusMetres": { "type": ["number", "null"], "exclusiveMinimum": 0 }
      }
    },
    "terms": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "component", "units", "provenance", "spatialHandling", "aggregation", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "component": { "enum": ["baseline", "terrain"] },
          "units": { "const": "m" },
          "provenance": { "type": "string", "minLength": 1 },
          "spatialHandling": { "type": "string", "minLength": 1 },
          "aggregation": { "const": "sum-absolute-bounds" },
          "status": { "enum": ["bounded", "pending-bound"] }
        }
      }
    },
    "checkStatus": { "enum": ["passed", "pending", "failed", "not-applicable"] }
  }
}
