{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artemsemdev.github.io/SeaRise-Europe/pipeline/offline-release/profile.schema.json",
  "title": "SeaRise Europe offline release profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "profile", "availability", "dataVersion", "dataProvenanceClass", "inputRootPath", "schemaDirectory", "environment", "tools", "sourceReceiptPaths", "parameters", "stageGraph"],
  "properties": {
    "$schema": { "const": "./profile.schema.json" },
    "schemaVersion": { "const": 1 },
    "profile": { "enum": ["fixture", "regional", "full-europe"] },
    "availability": { "enum": ["fixture-ready", "controlled-input-required"] },
    "dataVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "dataProvenanceClass": { "enum": ["real-source", "synthetic-fixture"] },
    "inputRootPath": { "$ref": "#/$defs/path" },
    "schemaDirectory": { "$ref": "#/$defs/path" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "architecture", "pythonVersion", "lockPath"],
      "properties": {
        "platform": { "enum": ["linux", "darwin"] },
        "architecture": { "enum": ["x86_64", "arm64"] },
        "pythonVersion": { "type": "string", "pattern": "^3\\.[0-9]+\\.[0-9]+$" },
        "lockPath": { "$ref": "#/$defs/path" }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "identityPaths"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
          "version": { "type": "string", "minLength": 1 },
          "identityPaths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/repositoryPath" } }
        }
      }
    },
    "sourceReceiptPaths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
    "parameters": { "type": "object" },
    "stageGraph": {
      "type": "array",
      "prefixItems": [
        { "const": "verify-sources" }, { "const": "inspect" }, { "const": "normalize" },
        { "const": "derive" }, { "const": "package" }, { "const": "validate" },
        { "const": "assemble-release" }
      ],
      "items": false,
      "minItems": 7,
      "maxItems": 7
    }
  },
  "$defs": {
    "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[?#\\\\])(?:[A-Za-z0-9][A-Za-z0-9._-]*)(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$" },
    "repositoryPath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[?#\\\\])(?:[A-Za-z0-9_][A-Za-z0-9._-]*)(?:/[A-Za-z0-9_][A-Za-z0-9._-]*)*$" }
  }
}
