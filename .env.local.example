# =============================================================================
# SeaRise Europe — Legacy Local Environment Variables
# =============================================================================
# This file configures the temporary Docker migration baseline. The accepted
# ADR-021 production architecture has no runtime geocoder, application API, or
# browser API keys. Remove this template with the legacy stack after parity.
#
# Copy this file to .env.local before running Docker Compose:
#   cp .env.local.example .env.local
#
# .env.local is gitignored — secrets are never committed.
# =============================================================================

# ---------------------------------------------------------------------------
# Legacy geocoding (ADR-019 is superseded by ADR-021)
# ---------------------------------------------------------------------------
# Required for geocoding API calls in the api container.
# Obtain from Azure Portal → Azure Maps account → Authentication → Primary Key.
# Leave empty to skip geocoding during early local development.
GEOCODING_API_KEY=

# ---------------------------------------------------------------------------
# Legacy basemap (ADR-020 is superseded by ADR-021)
# ---------------------------------------------------------------------------
# Azure Maps style URL including your subscription key.
# Obtain from Azure Portal → Azure Maps account → Authentication → Primary Key.
# Uses the same legacy Azure Maps account as geocoding.
# Leave empty to use the CARTO Dark fallback during early local development.
BASEMAP_STYLE_URL=
